{
  "schemaVersion": 1,
  "id": "mekanismadditions",
  "version": "${version}",
  "name": "Mekanism: Additions",
  "description": "Plastic building blocks, balloons, baby mobs and walkie-talkies.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mekanism.additions.common.MekanismAdditions"
    ],
    "client": [
      "mekanism.additions.client.AdditionsClientInitializer"
    ]
  },
  "license": "MIT",
  "icon": "logo.png",
  "depends": {
    "mekanism": "${version}",
    "minecraft": "1.20.1",
    "fabricloader": ">=0.18.2",
    "fabric-api": "*"
  },
  "mixins": [
    "mekanismadditions.mixins.json"
  ]
}
